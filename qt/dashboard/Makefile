install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/qt5-arm/examples/quickcontrols/extras/dashboard || mkdir -p $(INSTALL_ROOT)/opt/qt5-arm/examples/quickcontrols/extras/dashboard
	-$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/qt5-arm/examples/quickcontrols/extras/dashboard/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/qt5-arm/examples/quickcontrols/extras/dashboard/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/qt5-arm/examples/quickcontrols/extras/dashboard/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/qt5-arm/examples/quickcontrols/extras/dashboard/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

